# Behind Cloudflare's CDN (orange cloud): HTTPS between Cloudflare and this server uses a Cloudflare origin
# certificate, kept in ./secrets on the server. It is valid for years and never needs renewing.
# Use it with CREATIVECUT_CADDYFILE=Caddyfile.origin in .env, and SSL/TLS mode "Full (strict)" in Cloudflare.
{$CREATIVECUT_DOMAIN} {
	tls /secrets/cloudflare-origin.crt /secrets/cloudflare-origin.key
	encode zstd gzip
	request_body {
		max_size 1MB
	}
	reverse_proxy app:8765
}
