# ---- Creative Cut settings. Copy this file to .env and fill it in. Never commit .env. ----
#
# On your own computer you need nothing here: start Creative Cut, open it, and add your AI key under Settings, AI.
# This file is for servers, and for anyone who prefers to keep settings in a file.

# ================================================================ AI: bring your own key
# The easy way is the dashboard: Settings, AI. Whatever is saved there is used instead of these lines.
# Creative Cut uses an AI model to pick the moments worth clipping and to write hooks, titles and captions.
# You choose the service and pay that service directly; Creative Cut adds nothing on top.
# Without a key Creative Cut still works: clips are then picked by loudness only, with no titles.
#
#   provider     where to get a key                          example model ids (check the provider's current list)
#   gemini       https://aistudio.google.com/apikey           gemini-2.5-flash
#   openai       https://platform.openai.com/api-keys         gpt-4o-mini
#   xai          https://console.x.ai                         grok-4            (Grok)
#   groq         https://console.groq.com/keys                llama-3.3-70b-versatile
#   openrouter   https://openrouter.ai/keys                   any model id listed there
#   anthropic    https://console.anthropic.com                a current Claude model id
#   ollama       no key: a model running on this machine      llama3.1          (ollama pull llama3.1)
#   custom       any service that speaks the OpenAI chat format: also set CREATIVECUT_AI_BASE_URL
# With sign-in on, each person brings their own key (Settings, AI) and these lines are not used, unless you also
# set CREATIVECUT_SHARED_AI=1: then people who have no key of their own use the one below, and you pay for it.
# CREATIVECUT_SHARED_AI=0
CREATIVECUT_AI_PROVIDER=gemini
CREATIVECUT_AI_MODELS=
CREATIVECUT_AI_KEY=
# CREATIVECUT_AI_KEY_FILE=/secrets/ai.txt        # instead of CREATIVECUT_AI_KEY: a file that holds the key
# CREATIVECUT_AI_BASE_URL=                       # only for "custom", e.g. http://127.0.0.1:1234/v1
# CREATIVECUT_AI_MODELS takes several ids separated by commas. They are tried in order, so the second is a fallback.

# ================================================================ on a server (Docker): see DEPLOY.md
# Your domain (DNS must already point at this server) and a database password you make up.
# CREATIVECUT_DOMAIN=creativecut.example.com
# POSTGRES_PASSWORD=change-me-to-a-long-random-string

# A server Creative Cut has to itself: keep this line, and Creative Cut fetches its own HTTPS certificate.
# A server that already runs a web server for other sites: leave it out and see deploy/nginx-creativecut.conf.
# COMPOSE_PROFILES=own-https
# Behind Cloudflare's CDN: put the Cloudflare origin certificate in ./secrets as cloudflare-origin.crt and
# cloudflare-origin.key, and use the Caddyfile that serves it.
# CREATIVECUT_CADDYFILE=Caddyfile.origin
# CREATIVECUT_BIND_PORT=8765           # the port Creative Cut listens on inside the server, if 8765 is taken
# Behind a Traefik that is already on the server, use this instead of the own-https line:
# COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.traefik.yml
# If the domain goes through Cloudflare's CDN (orange cloud), the visitor's real address comes in this header.
# It is only believed for connections that really come from Cloudflare.
# CREATIVECUT_CLIENT_IP_HEADER=CF-Connecting-IP

# On a server shared with other apps: keep Creative Cut inside its own share.
# CREATIVECUT_MEM_LIMIT=2g             # most memory it may use (it is stopped, not the other apps, if it goes over)
# CREATIVECUT_CPUS=1.5                 # most processor cores it may use
# CREATIVECUT_CPU_SHARES=256           # its turn at the processor when the server is busy (1024 is normal)
# CREATIVECUT_OOM_SCORE_ADJ=900        # if the whole server runs out of memory, Creative Cut is stopped first
# CREATIVECUT_DB_MEM_LIMIT=256m

# ================================================================ where things are kept (own computer)
# CREATIVECUT_DATA=./data              # videos, clips, the database file and the speech model
# CREATIVECUT_PORT=8765
# CREATIVECUT_PUBLIC_URL=http://127.0.0.1:8765     # the address people open; set it to https://your-domain on a server
# DATABASE_URL=                    # empty: a SQLite file in the data folder. Or postgresql+psycopg://user:pass@host/db

# ================================================================ sign-in
# Off by default: Creative Cut opens straight into the dashboard, which is right for your own computer.
# On a server other people can reach, turn accounts on, or anyone who finds the address can use it and your AI key.
# (docker-compose.yml turns them on by itself.)
# CREATIVECUT_ACCOUNTS=1

# ================================================================ admins (only with accounts on)
# Admins are not set here. Every new account is a normal user. After you sign up, make yourself an admin:
#   python -m studio.admin grant you@example.com                 (also: revoke, list)
#   docker compose exec app python -m studio.admin grant you@example.com      (with Docker)
# The admin dashboard is then at /admin, and does not exist for anyone else.

# ================================================================ Google (optional)
# One "Web application" OAuth client, used for Sign in with Google and for connecting YouTube to post Shorts.
# Authorised redirect URIs:  https://YOUR-DOMAIN/auth/google/callback  and  https://YOUR-DOMAIN/oauth/youtube/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CLIENT_FILE=/secrets/google_client.json

# Instagram and TikTok: the apps people's accounts connect through (Connect buttons in Settings, Connected apps).
# These can also be pasted in the dashboard by an admin: Settings, Connected apps, Set up. Redirect addresses to
# register:  https://YOUR-DOMAIN/oauth/instagram/callback  and  https://YOUR-DOMAIN/oauth/tiktok/callback
# CREATIVECUT_IG_APP_ID=
# CREATIVECUT_IG_APP_SECRET=
# CREATIVECUT_TIKTOK_CLIENT_KEY=
# CREATIVECUT_TIKTOK_CLIENT_SECRET=

# ================================================================ YouTube refusing the server
# YouTube often refuses downloads from a server ("confirm you're not a bot"). Two things help. When a link still fails,
# the person is asked to download the video themselves and upload it (see below).
# 1. Cookies from a spare YouTube account (not your main one; see DEPLOY.md). Put the file in ./secrets and give the path
#    as the container sees it. Also: yt-dlp is kept up to date (a newer one is fetched every 24 hours, and after a refusal; 0 = off).
# When a link cannot be downloaded the person can upload the video. Biggest file allowed, in MB. It is sent in pieces of
# CHUNK MB; nginx in front must allow one piece (client_max_body_size, see DEPLOY.md):
# CREATIVECUT_MAX_UPLOAD_MB=500
# CREATIVECUT_UPLOAD_CHUNK_MB=40
# Every morning (India time, 6 o'clock) the server deletes uploads that were started and never finished. Hour 0 to 23, or -1 to turn off:
# CREATIVECUT_CLEANUP_HOUR_IST=6
# CREATIVECUT_YT_COOKIES=/secrets/youtube-cookies.txt
# CREATIVECUT_YTDLP_UPDATE_HOURS=24

# ================================================================ email (optional)
# Any SMTP service. Without it, password-reset and confirmation links are printed in the server's output instead,
# which is enough on your own computer.
# CREATIVECUT_SMTP_HOST=
# CREATIVECUT_SMTP_PORT=587
# CREATIVECUT_SMTP_USER=
# CREATIVECUT_SMTP_PASSWORD=
# CREATIVECUT_SMTP_PASSWORD_FILE=/secrets/smtp.txt
# CREATIVECUT_MAIL_FROM=Creative Cut <hello@your-domain.com>
# CREATIVECUT_VERIFY_EMAIL=1           # on a public site: people must confirm their email before clipping

# Shown on the privacy, terms and acceptable-use pages of a public site.
# CREATIVECUT_CONTACT_EMAIL=
# CREATIVECUT_LEGAL_NAME=
# CREATIVECUT_LEGAL_COUNTRY=

# ================================================================ limits (all optional)
# How many videos run at once is decided by how busy the machine really is, every second. These only set the edges:
# CREATIVECUT_JOB_WORKERS=8            # the most videos that may ever run at once (default: one per CPU core)
# CREATIVECUT_BUSY_CPU=82              # no extra video or recording starts while the processor is above this percent
# CREATIVECUT_MIN_FREE_RAM_GB=1.5      # ...or while less memory than this is free
# Everything here is off (0) unless said otherwise. Each account gets 100 MB for its clips by default; over it, the oldest videos are deleted.
# CREATIVECUT_MAX_LIVE=8               # live recordings at once, whole server (default: twice the CPU cores; load decides below it)
# CREATIVECUT_MAX_LIVE_PER_USER=0      # streams one person records at once
# CREATIVECUT_MAX_JOBS_PER_USER=1      # videos one person has worked on at once (the next waits, or they cancel)
# The free plan (studio/plan.py). Admins, and the owner without sign-in, are never limited.
# CREATIVECUT_FREE_VIDEOS=5            # videos a free account may turn into clips in all; only finished ones count; 0 = no limit
# CREATIVECUT_CLIPS_PER_VIDEO=3        # clips made from one video; "Create more" says a paid plan is coming
# CREATIVECUT_FREE_REMAKES=1           # times a free account may re-make one clip after changing it; 0 = no limit
# CREATIVECUT_VISUAL=1                 # look at each clip's picture (movement, shot changes) as well as the sound; 0 turns it off
# CREATIVECUT_MAX_VIDEO_HOURS=0        # longest video, or chosen part of one, that is processed
# CREATIVECUT_MAX_LIVE_HOURS=0         # a live recording stops by itself after this long
# CREATIVECUT_MAX_USER_MB=100         # space one account has for its clips. Over it, their oldest videos are deleted.
# CREATIVECUT_MAX_CREATORS=0           # creators one account may add
# CREATIVECUT_ALLOWED_SITES=youtube.com,youtu.be,twitch.tv,kick.com
# CREATIVECUT_YT_TRANSCRIPT=1          # use YouTube's own transcript to find clips faster (0: always transcribe here)
# CREATIVECUT_UPDATE_CHECK=1          # look on GitHub every few hours for a newer Creative Cut (0: never)

# ================================================================ speech to text on a graphics card (optional)
# Speech is transcribed on this machine's processor by default. A second machine with an NVIDIA card can take
# over most of it: see deploy/gpu/docker-compose.yml, then set these on the main server.
# CREATIVECUT_ASR_URL=http://10.0.0.2:9000
# CREATIVECUT_ASR_TOKEN=a-long-random-string-shared-by-both-machines
